[Unit]
Description=CanPi CAN-bus Web Application
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/canpi/canpi-web

# Set up CAN interfaces on the host first
ExecStartPre=/bin/bash /home/canpi/canpi-web/setup-can.sh

# Start the Docker container
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
